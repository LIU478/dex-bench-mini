# 虚拟环境
dex-env/

# Isaac Lab 源码（太大，不需要上传）
IsaacLab/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 大型训练文件（checkpoints, 日志）
*.pth
logs/
*.log

# 大型数据文件（演示数据集）
*.hdf5

# 输出目录中的大文件（但允许 PNG/图片和 README）
outputs/*
!outputs/*.png
!outputs/*.md
experiments/*/outputs/*
!experiments/*/outputs/*.png
!experiments/*/outputs/*.md

# 脚本仓库中的文件（我们的脚本已强制添加）
# 允许 .py 脚本
scripts/*.py

# 临时文件
*.tmp
*.bak
.DS_Store
